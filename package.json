{
  "name": "mapfolio",
  "displayName": "MapFolio",
  "version": "1.6.3",
  "private": true,
  "description": "Interactive mapping app for creating, annotating, and printing custom maps",
  "author": "Jay Deaton",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "fix": "eslint . --fix",
    "generate": "nuxt generate",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "preview": "nuxt preview",
    "release": "git push --follow-tags",
    "release:major": "npm version major && npm run release",
    "release:minor": "npm version minor && npm run release",
    "release:patch": "npm version patch && npm run release",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "typecheck": "nuxt typecheck",
    "verify": "npm run lint && npm test && npm run typecheck && npm run build",
    "preversion": "npm ci && npm run verify"
  },
  "prettier": "@infinitetoken/eslint-config/prettier",
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@nuxtjs/color-mode": "^4.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vue-leaflet/vue-leaflet": "^0.10.0",
    "leaflet": "^1.9.4",
    "leaflet-geosearch": "^4.0.0",
    "leaflet.markercluster": "^1.5.3",
    "nuxt": "^4.4.6",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.0",
    "vue-router": "^5.1.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@infinitetoken/eslint-config": "^0.2.1",
    "@nuxt/test-utils": "^4.0.3",
    "@types/leaflet": "^1.9.4",
    "@types/node": "^25.0.0",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.4.1",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
